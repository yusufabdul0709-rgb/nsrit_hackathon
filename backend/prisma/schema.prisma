// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  phone     String   @unique
  password  String
  name      String?
  email     String?
  role      String   @default("PASSENGER") // PASSENGER, CONDUCTOR, DRIVER, ADMIN
  balance   Float    @default(0.0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tickets   Ticket[]
}

model Vehicle {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  busNumber    String   @unique
  capacity     Int
  currentLat   Float?
  currentLng   Float?
  lastUpdate   DateTime?
  trips        Trip[]
}

// APSRTC specific AI Route & Fare Knowledge Base
model Stop {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  stopId           String   
  stopName         String
  lat              Float?
  lng              Float?
  stageNumber      Int?
  depot            String?
  district         String?
  sequenceNumber   Int?
  highwayDistance  Float?   // Distance from origin
  routeId          String   @db.ObjectId
  route            Route    @relation(fields: [routeId], references: [id])

  @@unique([routeId, sequenceNumber])
}

model Route {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  routeId        String   @unique
  serviceType    String   // Palle Velugu, Express, Metro Express, City Ordinary
  routeName      String
  origin         String
  destination    String
  totalDistance  Float?
  totalStages    Int?
  stops          Stop[]
  trips          Trip[]
}

model FareModel {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  serviceType    String   @unique
  minFare        Float
  baseFare       Float
  farePerKm      Float?
  stageFare      Float?
  luggageRules   Json?
  passengerRules Json?
  applicableTaxes Float?
  roundingRules  String?
}

model PassengerCategory {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  categoryName   String   @unique // Adult, Child, Senior Citizen, etc.
  fareMultiplier Float    @default(1.0)
  discountFlat   Float    @default(0.0)
}

model LuggageRule {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  weightSlab     String   @unique // e.g., "0-10kg", "10-25kg"
  additionalFare Float    @default(0.0)
}

model Trip {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tripId    String?  @unique
  routeId   String   @db.ObjectId
  vehicleId String   @db.ObjectId
  status    String   @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED
  startTime DateTime?
  endTime   DateTime?
  route     Route    @relation(fields: [routeId], references: [id])
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  tickets   Ticket[]
}

model Ticket {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  ticketRef        String?  @unique
  userId           String?  @db.ObjectId
  tripId           String   @db.ObjectId
  serviceType      String?
  sourceStop       String?
  destinationStop  String?
  distance         Float?
  amount           Float
  status           String   @default("VALID") // VALID, USED, CANCELLED
  qrData           String?  @unique
  digitalSignature String?
  orderId          String?
  createdAt        DateTime @default(now())
  
  user             User?    @relation(fields: [userId], references: [id])
  trip             Trip     @relation(fields: [tripId], references: [id])
}

model Payment {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  ticketId         String   @db.ObjectId
  orderId          String   @unique
  paymentId        String?
  signature        String?
  amount           Float
  status           String   @default("PENDING") // PENDING, SUCCESS, FAILED
  createdAt        DateTime @default(now())
}

model TrainingMetadata {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  version          String   @unique
  datasetName      String
  status           String   @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, FAILED
  trainedAt        DateTime @default(now())
  logs             String?
}
