// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  phone     String   @unique
  password  String
  name      String?
  email     String?
  role      String   @default("PASSENGER") // PASSENGER, CONDUCTOR, DRIVER, ADMIN
  balance   Float    @default(0.0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tickets   Ticket[]
}

model Vehicle {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  busNumber    String   @unique
  capacity     Int
  currentLat   Float?
  currentLng   Float?
  lastUpdate   DateTime?
  trips        Trip[]
}

model Route {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  startStop String
  endStop   String
  trips     Trip[]
}

model Trip {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  routeId   String   @db.ObjectId
  vehicleId String   @db.ObjectId
  status    String   @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED
  startTime DateTime?
  endTime   DateTime?
  route     Route    @relation(fields: [routeId], references: [id])
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  tickets   Ticket[]
}

model Ticket {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  tripId    String   @db.ObjectId
  amount    Float
  status    String   @default("VALID") // VALID, USED, CANCELLED
  qrData    String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  trip      Trip     @relation(fields: [tripId], references: [id])
}
